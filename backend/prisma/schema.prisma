generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  fullName            String?
  companyName         String?
  phone               String?
  isVerified          Boolean              @default(false)
  verificationToken   String?              @unique
  tokenExpiresAt      DateTime?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customers           Customer[]
  firms               Firm[]
  invoices            Invoice[]
  profile             Profile?
  vehicles            Vehicle[]
  sessions            Session[]
  apiKeys             ApiKey[]
  oauthAuthorizations OAuthAuthorization[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  isValid      Boolean  @default(true)
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  fullName                  String   @default("")
  companyName               String   @default("")
  email                     String   @default("")
  phone                     String   @default("")
  gstin                     String   @default("")
  address                   String   @default("")
  transportLicense          String   @default("")
  subscriptionPlan          String   @default("Standard Plan")
  enablePostOfficeSelection Boolean  @default(false)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Firm {
  id                 String    @id @default(uuid())
  businessName       String
  ownerName          String?
  phone              String?
  email              String?
  gstin              String?
  pan                String?
  address            String?
  city               String?
  state              String?
  pin                String?
  logoPath           String?
  signaturePath      String?
  isDefault          Boolean   @default(false)
  showPhoneOnInvoice Boolean   @default(true)
  showGstinOnInvoice Boolean   @default(true)
  showEmailOnInvoice Boolean   @default(true)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
}

model Customer {
  id           String    @id @default(uuid())
  customerName String
  phone        String?
  gstin        String?
  address      String?
  city         String?
  state        String?
  pin          String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
}

model Vehicle {
  id              String    @id @default(uuid())
  vehicleNumber   String
  type            String    @default("Open Truck")
  capacity        Float     @default(0.0)
  driverName      String?
  driverPhone     String?
  insuranceNumber String?
  fitnessExpiry   String?
  status          String    @default("available")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  invoices        Invoice[]
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                   String    @id @default(uuid())
  invoiceNumber        String    @unique
  invoiceDate          DateTime  @default(now())
  tripDate             DateTime  @default(now())
  firmId               String?
  customerId           String?
  vehicleId            String?
  sourcePin            String?
  sourceCity           String?
  sourceDistrict       String?
  sourceState          String?
  sourceAddress        String?
  destinationPin       String?
  destCity             String?
  destDistrict         String?
  destState            String?
  destAddress          String?
  materialDescription  String?
  weight               Float?
  transportationCharge Float     @default(0.0)
  customPartiesFields  String?   @default("{}")
  customChargesFields  String?   @default("{}")
  totalAmount          Float     @default(0.0)
  paymentMethod        String    @default("cash")
  paymentStatus        String    @default("pending")
  remarks              String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  userId               String
  customer             Customer? @relation(fields: [customerId], references: [id])
  firm                 Firm?     @relation(fields: [firmId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id])
}

model BlockedSignup {
  id        String   @id @default(uuid())
  email     String
  reason    String
  ipAddress String?
  createdAt DateTime @default(now())
}

enum AccessType {
  READ_ONLY
  READ_WRITE
}

model ApiKey {
  id         String     @id @default(uuid())
  keyHash    String     @unique
  name       String?
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes     String[]   @default(["invoices:read"])
  accessType AccessType @default(READ_ONLY)
  isActive   Boolean    @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Set only for keys issued through OAuth; keys from scripts/apiKey.js leave these null.
  clientId         String?
  client           OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  refreshTokenHash String?      @unique
  refreshExpiresAt DateTime?
  resource         String?

  @@map("api_keys")
}

// An OAuth client registered through dynamic client registration (RFC 7591), e.g. Claude Code.
model OAuthClient {
  id             String               @id @default(uuid())
  name           String?
  redirectUris   String[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  apiKeys        ApiKey[]
  authorizations OAuthAuthorization[]

  @@map("oauth_clients")
}

// One /oauth/authorize attempt. Pending until the user approves it on the sign-in page,
// then holds the single-use authorization code until it is exchanged at /oauth/token.
model OAuthAuthorization {
  id            String      @id @default(uuid())
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri   String
  state         String?
  codeChallenge String
  scopes        String[]
  resource      String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String?     @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
  @@map("oauth_authorizations")
}

// No foreign keys on purpose: audit rows must outlive deleted keys and users.
model ApiAuditLog {
  id         String   @id @default(uuid())
  apiKeyId   String?
  userId     String?
  method     String
  path       String
  query      Json?
  statusCode Int
  ip         String?
  userAgent  String?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@map("api_audit_logs")
}
